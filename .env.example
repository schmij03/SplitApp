# Öffentliche HTTPS-Adresse der App (Pflicht für Claude/ChatGPT)
PUBLIC_URL=https://splitapp.example.com
PORT=3000
# Zufälliger, geheimer Wert (z. B. `openssl rand -hex 32`)
APP_SECRET=
# Speicherort der SQLite-Datenbank
DATA_DIR=./data
# Registrierung neuer Konten erlauben (true/false)
ALLOW_REGISTRATION=true
# Anzahl vertrauenswürdiger Reverse-Proxies (Standard bei https: 1)
# TRUST_PROXY=1
