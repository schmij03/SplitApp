{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "splitapp",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  // nodejs_compat für das MCP-SDK, global_fetch_strictly_public für sichere CIMD-Abrufe (OAuth)
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  // Der Worker liefert die gebaute Oberfläche (npm run build) gleich mit aus.
  // Läuft sie zusätzlich auf GitHub Pages, setzt der Deploy-Workflow WEB_URL auf deren Adresse.
  "assets": { "directory": "./dist/web" },
  "vars": {
    "ALLOW_REGISTRATION": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "splitapp",
      // wird beim Deploy (Knopf oder GitHub Actions) automatisch gesetzt
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      // Speicher der OAuth-Bibliothek (Clients, Grants, Tokens; nur als Hash)
      "binding": "OAUTH_KV",
      // wird beim ersten Deployment automatisch gesetzt
      "id": "00000000000000000000000000000000"
    }
  ],
  "ratelimits": [
    {
      // Schutz vor Passwort-Raten: 10 Anmeldeversuche pro Minute und IP
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
